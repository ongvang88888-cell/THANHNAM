# Copy to a private .env on the server. Never commit real values.
# Run: bash scripts/ops/check-production-env.sh .env

NODE_ENV=production
API_PORT=3001

POSTGRES_USER=edu
POSTGRES_PASSWORD=replace-with-long-random-password
POSTGRES_DB=edu_commerce
DATABASE_URL=postgresql://edu:replace-with-long-random-password@postgres:5432/edu_commerce?schema=public
REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=replace-with-32-plus-random-chars-access
JWT_REFRESH_SECRET=replace-with-32-plus-random-chars-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

APP_ID=education_app
CORS_ORIGINS=https://YOUR-DOMAIN
PUBLIC_WEB_URL=https://YOUR-DOMAIN
NEXT_PUBLIC_API_URL=https://YOUR-DOMAIN/api/v1
NEXT_PUBLIC_APP_ID=education_app
EXPO_PUBLIC_API_URL=https://YOUR-DOMAIN/api/v1
EXPO_PUBLIC_APP_ID=education_app

STORAGE_DRIVER=s3
S3_REGION=ap-southeast-1
S3_BUCKET_PRIVATE=edu-private
S3_BUCKET_PUBLIC=edu-public
S3_ACCESS_KEY=
S3_SECRET_KEY=
AWS_REGION=ap-southeast-1
MEDIA_SIGNING_SECRET=replace-with-32-plus-media-signing
MEDIA_WEBHOOK_SECRET=replace-with-32-plus-media-webhook

DEFAULT_PAYMENT_PROVIDER=vnpay
ALLOW_MOCK_PAYMENTS=false
ALLOW_DEV_SSV=false
ALLOW_IAP_TEST_TOKENS=false
ALLOW_LOCAL_MEDIA=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://pay.vnpay.vn/vpcpay.html
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EduCommerce <noreply@YOUR-DOMAIN>
INVOICE_VAT_BPS=0

SELL_ON_PLAY=false
GOOGLE_PLAY_PACKAGE_NAME=com.educommerce.student
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Optional VPS TLS (Caddy)
PUBLIC_DOMAIN=YOUR-DOMAIN
