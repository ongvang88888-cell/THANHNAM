# Appended by deploy/vps/bootstrap.sh. Do not replace the rest of Caddyfile.
# Serves the school site on a hostname so an existing :80 app stays untouched.

{$PUBLIC_HOST} {
	request_body {
		max_size 450MB
	}

	@compressible {
		not path /api/v1/media/local*
	}
	encode @compressible zstd gzip

	@api path /api/*
	reverse_proxy @api 127.0.0.1:3001

	reverse_proxy 127.0.0.1:3000
}
