[Unit]
Description=EduCommerce web
After=network.target edu-api.service
Wants=edu-api.service

[Service]
Type=simple
WorkingDirectory=/opt/edu-commerce/apps/web
EnvironmentFile=/opt/edu-commerce/.env
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=NODE_OPTIONS=--max-old-space-size=768
ExecStart=/opt/edu-commerce/apps/web/node_modules/.bin/next start -p 3000 -H 127.0.0.1
Restart=always
RestartSec=5
LimitNOFILE=65535
MemoryMax=1536M
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
