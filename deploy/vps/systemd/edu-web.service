[Unit]
Description=EduCommerce web
After=network.target edu-api.service
Wants=edu-api.service

[Service]
Type=simple
WorkingDirectory=/opt/edu-commerce/apps/web
EnvironmentFile=/opt/edu-commerce/.env
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/opt/edu-commerce/node_modules/.bin/next start -p 3000 -H 127.0.0.1
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
