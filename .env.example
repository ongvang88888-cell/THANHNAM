MOMO_NOTIFY_URL=http://localhost:4000/payments/webhooks/momo

# ZaloPay (optional — demo works without secrets)
ZALOPAY_APP_ID=2553
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_URL=https://sb-openapi.zalopay.vn/v2/create

# Affiliate default commission (bps); per-code overrides in AffiliateCode
AFFILIATE_DEFAULT_BPS=1000
# Affiliate min payout (VND minor units) — Unica-style floor
AFFILIATE_MIN_PAYOUT_MINOR=500000
ABANDON_CHECKOUT_MS=1800000
IDLE_LEARNING_MS=259200000
ADMOB_SSV_KEYS_URL=https://gstatic.com/admob/reward/verifier-keys.json
ADMOB_SSV_ENFORCE=false
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MEDIACONVERT_ENDPOINT=
MEDIACONVERT_ROLE_ARN=
MEDIACONVERT_QUEUE_ARN=
MEDIACONVERT_OUTPUT_BUCKET=
