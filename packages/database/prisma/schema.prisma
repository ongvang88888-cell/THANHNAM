generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
  DELETED
}

enum ProductType {
  VIDEO_COURSE
  DIGITAL_DOCUMENT
  COURSE_BUNDLE
  DOCUMENT_BUNDLE
  MIXED_BUNDLE
  SUBSCRIPTION
  PREMIUM_LIBRARY
  CERTIFICATE_PRODUCT
  OTHER_DIGITAL_PRODUCT
}

enum ProductStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
  REJECTED
}

enum Visibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum OrderStatus {
  DRAFT
  AWAITING_PAYMENT
  PAID
  FULFILLED
  FAILED
  REFUND_PENDING
  REFUNDED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum EntitlementStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum EntitlementSource {
  PURCHASE
  SUBSCRIPTION
  BUNDLE
  REWARD
  COUPON
  ADMIN
  PROMOTION
}

enum PolicyType {
  FREE
  PREVIEW
  PURCHASE_REQUIRED
  SUBSCRIPTION_REQUIRED
  BUNDLE_REQUIRED
  REWARDED_AD
  PREREQUISITE_REQUIRED
  TIME_LOCKED
  ADMIN_GRANTED
}

enum ContentType {
  VIDEO
  DOCUMENT
  AUDIO
  IMAGE
  TEXT
  QUIZ
  ASSIGNMENT
  EXTERNAL
}

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum RewardTxStatus {
  PENDING
  VERIFIED
  GRANTED
  DENIED
}

enum VideoStatus {
  UPLOADING
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum ProcessingJobStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum CourseStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
  REJECTED
}

enum AffiliateCommissionStatus {
  PENDING
  EARNED
  REVERSED
}

model App {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  name                 String
  brandingJson         Json     @default("{}")
  enabledModulesJson   Json     @default("{}")
  monetizationConfigJson Json   @default("{}")
  status               String   @default("ACTIVE")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users     User[]
  products  Product[]
  categories Category[]
  tags      Tag[]
  courses   Course[]
  videos    Video[]
  documents Document[]
  orders    Order[]
  entitlements Entitlement[]
  rewardPolicies RewardPolicy[]
  rewardTransactions RewardTransaction[]
  subscriptions Subscription[]
  featureFlags FeatureFlag[]
  appConfigs AppConfig[]
  auditLogs AuditLog[]
  analyticsEvents AnalyticsEvent[]
  affiliateCodes AffiliateCode[]
  affiliateCommissions AffiliateCommission[]
  coupons Coupon[]
}

model User {
  id           String     @id @default(cuid())
  appId        String
  email        String
  passwordHash String
  status       UserStatus @default(ACTIVE)
  displayName  String
  locale       String     @default("vi")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  app App @relation(fields: [appId], references: [id])

  roles              UserRole[]
  sessions           Session[]
  devices            Device[]
  productsCreated    Product[]           @relation("ProductCreator")
  orders             Order[]
  entitlements       Entitlement[]
  rewardTransactions RewardTransaction[]
  subscriptions      Subscription[]
  courseProgress     CourseProgress[]
  lessonProgress     LessonProgress[]
  bookmarks          Bookmark[]
  notes              Note[]
  quizAttempts       QuizAttempt[]
  certificates       Certificate[]
  reviews            Review[]
  videosOwned        Video[]             @relation("VideoOwner")
  documentsOwned     Document[]          @relation("DocumentOwner")
  coursesTaught      Course[]            @relation("CourseCreator")
  notifications      Notification[]
  couponRedemptions  CouponRedemption[]
  auditLogs          AuditLog[]
  affiliateCodes     AffiliateCode[]
  wishlistItems      WishlistItem[]

  @@unique([appId, email])
  @@index([appId, status])
}

model Role {
  id     String  @id @default(cuid())
  appId  String?
  code   String
  name   String
  users  UserRole[]
  perms  RolePermission[]

  @@unique([appId, code])
}

model Permission {
  id          String @id @default(cuid())
  code        String @unique
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  scopeType String   @default("APP")
  scopeId   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@index([userId])
  @@index([roleId])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  deviceId         String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  familyId         String

  user User @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
  @@index([familyId])
}

model Device {
  id              String   @id @default(cuid())
  userId          String
  platform        String
  pushToken       String?
  fingerprintHash String?
  lastSeenAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Category {
  id       String  @id @default(cuid())
  appId    String
  parentId String?
  name     String
  slug     String
  path     String  @default("/")

  app      App       @relation(fields: [appId], references: [id])
  products Product[]

  @@unique([appId, slug])
}

model Tag {
  id    String @id @default(cuid())
  appId String
  name  String
  slug  String

  app      App          @relation(fields: [appId], references: [id])
  products ProductTag[]

  @@unique([appId, slug])
}

model Product {
  id              String        @id @default(cuid())
  appId           String
  type            ProductType
  name            String
  slug            String
  description     String        @default("")
  thumbnailUrl    String?
  status          ProductStatus @default(DRAFT)
  visibility      Visibility    @default(PUBLIC)
  creatorUserId   String?
  categoryId      String?
  metadataJson    Json          @default("{}")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  app      App           @relation(fields: [appId], references: [id])
  creator  User?         @relation("ProductCreator", fields: [creatorUserId], references: [id])
  category Category?     @relation(fields: [categoryId], references: [id])
  prices   ProductPrice[]
  tags     ProductTag[]
  course       Course?
  document     Document?
  bundle       Bundle?
  bundleItems  BundleItem[]
  orderItems   OrderItem[]
  reviews      Review[]
  wishlistItems WishlistItem[]

  @@unique([appId, slug])
  @@index([appId, type, status])
  @@index([appId, status, visibility])
}

model ProductPrice {
  id             String    @id @default(cuid())
  productId      String
  currency       String    @default("VND")
  amountMinor    Int
  compareAtMinor Int?
  validFrom      DateTime  @default(now())
  validTo        DateTime?

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id])
  tag       Tag     @relation(fields: [tagId], references: [id])

  @@id([productId, tagId])
}

model Course {
  id            String       @id @default(cuid())
  appId         String
  productId     String       @unique
  title         String
  level         String?
  language      String       @default("vi")
  status        CourseStatus @default(DRAFT)
  creatorUserId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  app      App             @relation(fields: [appId], references: [id])
  product  Product         @relation(fields: [productId], references: [id])
  creator  User?           @relation("CourseCreator", fields: [creatorUserId], references: [id])
  sections CourseSection[]
  quizzes  Quiz[]
  progress CourseProgress[]
  certificates Certificate[]

  @@index([appId, status])
}

model CourseSection {
  id       String @id @default(cuid())
  courseId String
  title    String
  position Int

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, position])
}

model Lesson {
  id                 String  @id @default(cuid())
  sectionId          String
  title              String
  position           Int
  durationSec        Int     @default(0)
  isPreview          Boolean @default(false)
  completionRuleJson Json    @default("{}")

  section   CourseSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  contents  LessonContent[]
  policies  AccessPolicy[]
  progress  LessonProgress[]

  @@index([sectionId, position])
}

model LessonContent {
  id          String      @id @default(cuid())
  lessonId    String
  contentType ContentType
  refId       String?
  body        String?
  position    Int         @default(0)
  metadataJson Json       @default("{}")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, position])
}

model AccessPolicy {
  id           String     @id @default(cuid())
  resourceType String
  resourceId   String
  policyType   PolicyType
  paramsJson   Json       @default("{}")
  priority     Int        @default(100)
  lessonId     String?

  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([resourceType, resourceId, priority])
}

model Video {
  id          String      @id @default(cuid())
  appId       String
  ownerUserId String?
  title       String
  status      VideoStatus @default(UPLOADING)
  durationMs  Int?
  storageKey  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  app     App                   @relation(fields: [appId], references: [id])
  owner   User?                 @relation("VideoOwner", fields: [ownerUserId], references: [id])
  assets  VideoAsset[]
  jobs    VideoProcessingJob[]

  @@index([appId, status])
}

model VideoAsset {
  id         String @id @default(cuid())
  videoId    String
  quality    String
  format     String
  storageKey String
  sizeBytes  BigInt @default(0)
  checksum   String?

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
}

model VideoProcessingJob {
  id        String              @id @default(cuid())
  videoId   String
  provider  String
  status    ProcessingJobStatus @default(QUEUED)
  attempts  Int                 @default(0)
  error     String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model Document {
  id          String   @id @default(cuid())
  appId       String
  productId   String?  @unique
  ownerUserId String?
  title       String
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  app      App                @relation(fields: [appId], references: [id])
  product  Product?           @relation(fields: [productId], references: [id])
  owner    User?              @relation("DocumentOwner", fields: [ownerUserId], references: [id])
  versions DocumentVersion[]

  @@index([appId, status])
}

model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  version    Int
  storageKey String
  mime       String
  sizeBytes  BigInt
  checksum   String?
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
}

model Bundle {
  id        String @id @default(cuid())
  productId String @unique
  campaign  String?
  purchaseLimit Int?
  startsAt  DateTime?
  endsAt    DateTime?

  product Product      @relation(fields: [productId], references: [id])
  items   BundleItem[]
}

model BundleItem {
  bundleId  String
  productId String
  position  Int    @default(0)

  bundle  Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@id([bundleId, productId])
  @@index([productId])
}

model Order {
  id               String      @id @default(cuid())
  appId            String
  userId           String
  status           OrderStatus @default(DRAFT)
  currency         String      @default("VND")
  totalMinor       Int         @default(0)
  discountMinor    Int         @default(0)
  couponId         String?
  affiliateCodeId  String?
  idempotencyKey   String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  app               App                   @relation(fields: [appId], references: [id])
  user              User                  @relation(fields: [userId], references: [id])
  items             OrderItem[]
  payments          Payment[]
  coupon            Coupon?               @relation(fields: [couponId], references: [id])
  affiliateCode     AffiliateCode?        @relation(fields: [affiliateCodeId], references: [id])
  affiliateCommission AffiliateCommission?

  @@unique([appId, idempotencyKey])
  @@index([appId, userId, createdAt])
  @@index([couponId])
  @@index([affiliateCodeId])
}

model OrderItem {
  id              String @id @default(cuid())
  orderId         String
  productId       String
  quantity        Int    @default(1)
  unitAmountMinor Int
  metadataJson    Json   @default("{}")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String
  provider       String
  providerRef    String?
  status         PaymentStatus @default(PENDING)
  amountMinor    Int
  currency       String        @default("VND")
  normalizedJson Json          @default("{}")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  refunds      Refund[]

  @@index([orderId])
  @@index([provider, providerRef])
}

model Transaction {
  id             String   @id @default(cuid())
  paymentId      String
  type           String
  amountMinor    Int
  providerEventId String?
  createdAt      DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([providerEventId])
  @@index([paymentId])
}

model Refund {
  id          String   @id @default(cuid())
  paymentId   String
  amountMinor Int
  reason      String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model Entitlement {
  id           String            @id @default(cuid())
  appId        String
  userId       String
  resourceType String
  resourceId   String
  source       EntitlementSource
  sourceRef    String
  status       EntitlementStatus @default(ACTIVE)
  grantedAt    DateTime          @default(now())
  expiresAt    DateTime?
  metadataJson Json              @default("{}")

  app  App  @relation(fields: [appId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([userId, resourceType, resourceId, source, sourceRef])
  @@index([appId, userId, resourceType, resourceId, status, expiresAt])
}

model Subscription {
  id                 String             @id @default(cuid())
  appId              String
  userId             String
  planProductId      String
  status             SubscriptionStatus @default(INCOMPLETE)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAt           DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  app    App                 @relation(fields: [appId], references: [id])
  user   User                @relation(fields: [userId], references: [id])
  events SubscriptionEvent[]

  @@index([appId, userId, status])
}

model SubscriptionEvent {
  id              String   @id @default(cuid())
  subscriptionId  String
  type            String
  providerEventId String?  @unique
  payloadJson     Json     @default("{}")
  createdAt       DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model RewardPolicy {
  id              String   @id @default(cuid())
  appId           String
  code            String
  resourceType    String?
  resourceId      String?
  durationHours   Int      @default(24)
  dailyLimit      Int      @default(5)
  cooldownMinutes Int      @default(0)
  enabled         Boolean  @default(true)
  paramsJson      Json     @default("{}")

  app App @relation(fields: [appId], references: [id])

  @@unique([appId, code])
}

model RewardTransaction {
  id                 String         @id @default(cuid())
  appId              String
  userId             String
  provider           String
  providerTxId       String
  policyId           String
  resourceType       String
  resourceId         String
  status             RewardTxStatus @default(PENDING)
  rewardSessionId    String
  verifiedAt         DateTime?
  grantEntitlementId String?
  createdAt          DateTime       @default(now())

  app  App  @relation(fields: [appId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerTxId])
  @@index([userId, createdAt])
  @@index([rewardSessionId])
}

model RewardSession {
  id           String   @id @default(cuid())
  userId       String
  appId        String
  resourceType String
  resourceId   String
  policyId     String
  nonce        String   @unique
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([userId, resourceType, resourceId])
}

model CourseProgress {
  id                String    @id @default(cuid())
  userId            String
  courseId          String
  percentBasisPoints Int      @default(0)
  lastLessonId      String?
  completedAt       DateTime?
  updatedAt         DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

model LessonProgress {
  id              String               @id @default(cuid())
  userId          String
  lessonId        String
  status          LessonProgressStatus @default(NOT_STARTED)
  videoPositionMs Int                  @default(0)
  timeSpentMs     Int                  @default(0)
  completedAt     DateTime?
  updatedAt       DateTime             @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
  @@index([userId, updatedAt])
}

model Bookmark {
  id           String   @id @default(cuid())
  userId       String
  resourceType String
  resourceId   String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, resourceType, resourceId])
}

model Note {
  id           String   @id @default(cuid())
  userId       String
  resourceType String
  resourceId   String
  body         String
  anchorJson   Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, resourceType, resourceId])
}

model Quiz {
  id         String @id @default(cuid())
  courseId   String
  title      String
  configJson Json   @default("{}")

  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  QuizAttempt[]
}

model Question {
  id           String @id @default(cuid())
  quizId       String
  type         String
  stem         String
  metadataJson Json   @default("{}")
  position     Int    @default(0)

  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers Answer[]
}

model Answer {
  id         String  @id @default(cuid())
  questionId String
  body       String
  isCorrect  Boolean @default(false)
  position   Int     @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id          String    @id @default(cuid())
  quizId      String
  userId      String
  score       Int       @default(0)
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  detailJson  Json      @default("{}")

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([quizId, userId])
}

model Certificate {
  id        String    @id @default(cuid())
  publicId  String    @unique
  userId    String
  courseId  String
  issuedAt  DateTime  @default(now())
  revokeAt  DateTime?
  metadataJson Json   @default("{}")

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@index([userId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  body      String   @default("")
  status    String   @default("VISIBLE")
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([productId, userId])
}

model Coupon {
  id              String    @id @default(cuid())
  appId           String
  code            String
  percentOff      Int?
  amountOffMinor  Int?
  currency        String    @default("VND")
  maxRedemptions  Int?
  startsAt        DateTime?
  endsAt          DateTime?
  enabled         Boolean   @default(true)

  app         App                @relation(fields: [appId], references: [id])
  redemptions CouponRedemption[]
  orders      Order[]

  @@unique([appId, code])
}

model AffiliateCode {
  id             String   @id @default(cuid())
  appId          String
  code           String
  ownerUserId    String
  commissionBps  Int      @default(1000)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  app          App                    @relation(fields: [appId], references: [id])
  owner        User                   @relation(fields: [ownerUserId], references: [id])
  commissions  AffiliateCommission[]
  orders       Order[]

  @@unique([appId, code])
  @@index([ownerUserId])
}

model AffiliateCommission {
  id              String                     @id @default(cuid())
  appId           String
  affiliateCodeId String
  orderId         String                     @unique
  amountMinor     Int
  currency        String
  status          AffiliateCommissionStatus  @default(PENDING)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  app           App            @relation(fields: [appId], references: [id])
  affiliateCode AffiliateCode  @relation(fields: [affiliateCodeId], references: [id])
  order         Order          @relation(fields: [orderId], references: [id])

  @@index([affiliateCodeId, status])
  @@index([appId, status])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@index([userId])
}

model CouponRedemption {
  id       String   @id @default(cuid())
  couponId String
  userId   String
  orderId  String?
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([couponId, userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  channel   String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())
  metaJson  Json     @default("{}")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model FeatureFlag {
  id      String  @id @default(cuid())
  appId   String
  key     String
  enabled Boolean @default(false)
  valueJson Json  @default("{}")

  app App @relation(fields: [appId], references: [id])

  @@unique([appId, key])
}

model AppConfig {
  id        String @id @default(cuid())
  appId     String
  key       String
  valueJson Json

  app App @relation(fields: [appId], references: [id])

  @@unique([appId, key])
}

model AuditLog {
  id         String   @id @default(cuid())
  appId      String
  actorUserId String?
  action     String
  resourceType String?
  resourceId String?
  metaJson   Json     @default("{}")
  createdAt  DateTime @default(now())

  app   App   @relation(fields: [appId], references: [id])
  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([appId, createdAt])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  appId     String
  userId    String?
  name      String
  propsJson Json     @default("{}")
  createdAt DateTime @default(now())

  app App @relation(fields: [appId], references: [id])

  @@index([appId, name, createdAt])
}
