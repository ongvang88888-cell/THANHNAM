# Prisma CLI resolves file:./dev.db relative to prisma/ (prisma/dev.db).
# The app ignores a 0-byte ./dev.db and prefers prisma/dev.db.
FMR_DATABASE_URL="file:./dev.db"
FMR_APP_ID=fmr_vn
FMR_COLLECT_KEY=
# Optional. systemd timer POST /api/summary/refresh every 6h (x-fmr-cron). Empty = same as collect / open local.
FMR_CRON_KEY=
FMR_LICENSED_FEED_PATH=
# HTTPS vendor the user already licensed — never facebook.com / graph.facebook.com
FMR_LICENSED_FEED_URL=
FMR_LICENSED_FEED_TOKEN=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# Overlay file (optional): data/platform-secrets.json — pasted from /nguon, never commit.
# Official YouTube Data API — public viewCount + search.list. Never scrape youtube.com.
# Views do not enter HeatScore.
YOUTUBE_API_KEY=
# Google Custom Search — official listing URLs only (site:tiki.vn …). Not sold counts.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
# Own-shop Open Platforms — never mixed into market HeatScore / /kenh sold.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=
SHOPEE_ACCESS_TOKEN=
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_ACCESS_TOKEN=
LAZADA_SELLER_ID=
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_ACCESS_TOKEN=
TIKTOK_SHOP_ID=
