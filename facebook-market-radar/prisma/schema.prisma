generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("FMR_DATABASE_URL")
}

model Niche {
  id        String           @id @default(cuid())
  appId     String
  slug      String
  nameVi    String
  nameEn    String
  clusters  ProductCluster[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([appId, slug])
  @@index([appId])
  @@map("niches")
}

model AdvertiserPage {
  id         String   @id @default(cuid())
  appId      String
  pageId     String
  pageName   String
  firstSeen  DateTime
  lastSeen   DateTime
  ads        Ad[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([appId, pageId])
  @@index([appId])
  @@map("advertiser_pages")
}

model ProductCluster {
  id           String                 @id @default(cuid())
  appId        String
  slug         String
  title        String
  imageUrl     String?
  nicheId      String
  niche        Niche                  @relation(fields: [nicheId], references: [id])
  ads          Ad[]
  links        AdProductLink[]
  snapshots      MarketSnapshot[]
  salesProxies   SalesProxyObservation[]
  researchLinks  ClusterResearchLink[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([appId, slug])
  @@index([appId])
  @@index([nicheId])
  @@map("product_clusters")
}

model AdCreative {
  id        String   @id @default(cuid())
  appId     String
  hash      String
  body      String?
  title     String?
  ads       Ad[]
  createdAt DateTime @default(now())

  @@unique([appId, hash])
  @@index([appId])
  @@map("ad_creatives")
}

model Ad {
  id           String          @id @default(cuid())
  appId        String
  libraryId    String
  pageId       String
  page         AdvertiserPage  @relation(fields: [pageId], references: [id])
  clusterId    String
  cluster      ProductCluster  @relation(fields: [clusterId], references: [id])
  creativeId   String
  creative     AdCreative      @relation(fields: [creativeId], references: [id])
  startDate    String
  isActive     Boolean         @default(true)
  platforms    String
  landingUrl   String?
  snapshotUrl  String?
  imageUrl     String?
  listingPriceVnd Int?
  firstSeen    DateTime
  lastSeen     DateTime
  links        AdProductLink[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([appId, libraryId])
  @@index([appId])
  @@index([pageId])
  @@index([clusterId])
  @@map("ads")
}

model AdProductLink {
  id        String         @id @default(cuid())
  adId      String
  clusterId String
  ad        Ad             @relation(fields: [adId], references: [id])
  cluster   ProductCluster @relation(fields: [clusterId], references: [id])
  createdAt DateTime       @default(now())

  @@unique([adId, clusterId])
  @@index([clusterId])
  @@map("ad_product_links")
}

model SalesProxyObservation {
  id          String         @id @default(cuid())
  appId       String
  clusterId   String
  cluster     ProductCluster @relation(fields: [clusterId], references: [id])
  source      String
  soldCount   Int
  observedAt  DateTime
  createdAt   DateTime       @default(now())

  @@index([appId, clusterId])
  @@map("sales_proxy_observations")
}

model MarketSnapshot {
  id                String         @id @default(cuid())
  appId             String
  clusterId         String
  cluster           ProductCluster @relation(fields: [clusterId], references: [id])
  weekStart         DateTime
  intensity         Float
  longevity         Float
  velocity          Float
  salesProxy        Float
  heat              Float
  activeAdCount     Int
  distinctPageCount Int
  createdAt         DateTime       @default(now())

  @@unique([appId, clusterId, weekStart])
  @@index([appId, weekStart])
  @@map("market_snapshots")
}

model ClusterResearchLink {
  id        String         @id @default(cuid())
  appId     String
  clusterId String
  cluster   ProductCluster @relation(fields: [clusterId], references: [id])
  platform  String
  url       String
  title     String?
  source    String
  createdAt DateTime       @default(now())

  @@unique([appId, clusterId, platform, url])
  @@index([appId, clusterId])
  @@map("cluster_research_links")
}

model OwnShopDaily {
  id        String   @id @default(cuid())
  appId     String
  platform  String
  shopId    String
  itemId    String
  itemName  String
  soldCount Int
  date      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([appId, platform, shopId, itemId, date])
  @@index([appId, platform])
  @@map("own_shop_daily")
}

model OwnInsightsDaily {
  id                 String   @id @default(cuid())
  appId              String
  adAccountId        String
  campaignId         String
  campaignName       String
  date               String
  spendMinor         Int
  impressions        Int
  purchases          Int
  purchaseValueMinor Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([appId, adAccountId, date, campaignId])
  @@index([appId, adAccountId])
  @@map("own_insights_daily")
}

model ProductWatch {
  id        String   @id @default(cuid())
  appId     String
  slug      String
  name      String
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([appId, slug])
  @@index([appId, createdAt])
  @@map("product_watches")
}

model Alert {
  id          String   @id @default(cuid())
  appId       String
  type        String
  title       String
  detail      String
  pageFbId    String?
  clusterSlug String?
  createdAt   DateTime

  @@index([appId, createdAt])
  @@map("alerts")
}

model PageWatch {
  id        String   @id @default(cuid())
  appId     String
  pageId    String
  pageName  String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([appId, pageId])
  @@index([appId, createdAt])
  @@map("page_watches")
}

model CreativeBoard {
  id        String      @id @default(cuid())
  appId     String
  slug      String
  name      String
  note      String?
  items     BoardItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([appId, slug])
  @@index([appId])
  @@map("creative_boards")
}

model BoardItem {
  id          String        @id @default(cuid())
  appId       String
  boardId     String
  board       CreativeBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  libraryId   String
  clusterSlug String
  createdAt   DateTime      @default(now())

  @@unique([boardId, libraryId])
  @@index([appId, clusterSlug])
  @@map("board_items")
}

model AdTag {
  id        String   @id @default(cuid())
  appId     String
  libraryId String
  tag       String
  createdAt DateTime @default(now())

  @@unique([appId, libraryId, tag])
  @@index([appId, tag])
  @@map("ad_tags")
}
